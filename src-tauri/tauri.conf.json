{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "qastor",
  "version": "0.1.0",
  "identifier": "local.adriandomc.qastor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "deno task dev",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "title": "Qastor",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$HOME/**/.qastor-runs/**",
          "/Users/**",
          "/var/folders/**",
          "/private/var/folders/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
